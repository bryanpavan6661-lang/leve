# Parâmetros da build da imagem

# Nome da imagem. IMPORTANTE: o repositório no GitHub precisa ter exatamente este nome
IMAGE_NAME=leve

# Seu usuário do GitHub
REPO_ORGANIZATION="bryanpavan6661-lang"

IMAGE_DESC="Sistema Linux leve (XFCE) sobre Fedora bootc, para PCs e notebooks"
